#!/bin/bash
# ./gr8 glm53 in the gr8 image: the same launcher, options, config file and checks as a bare-metal box, one container
# per box. Run the same command on every box, from any directory (relative paths and ./cluster.env resolve there).
#
#   docker/gr8 up [OPTIONS] [@FILE]      start this box's container, follow the boot until the cluster serves
#   docker/gr8 down | restart | status | logs | check | show-config | prepare | smoke | bench   as ./gr8 glm53 <command>
#
# OPTIONS are ./gr8 glm53's (KNOBS.md), from the command line, the config file and the environment as on bare metal. The
# launcher finds this box's peer index and fabric rails the same way inside the container (host network, the host's
# /sys/class/infiniband), so --peers, --ips/--ips2, --node-ip and the ports mean what they mean on bare metal.
#
# Environment for this script:
#   GR8_IMAGE   the image (default gr8: docker build -t gr8 . on one box, then docker save gr8 | ssh <box> docker load)
#   GR8_USER    the account the container runs as (default: you). Running docker takes root-equivalent rights; the
#               engine does not need them, so an account without sudo or docker can run it while you start it.
#   GR8_SSH     TP=6: the ssh directory the head's shim uses to reach the other boxes, mounted read-only as GR8_USER's
#               ~/.ssh (default ~GR8_USER/.ssh). From the head, `ssh -o BatchMode=yes <peer> true` must work for every
#               other peer address, with no prompt. TP=4 and TP=3 use no ssh, and no ssh directory is mounted.
#   G6_HOME     this box's working directory: out/, s2/, run/ and serve/ (default ~GR8_USER/gr8-docker). bin/ there is
#               a link into the image, so it must not be a bare-metal build's bin/.
#
# The container: --network host and --pid host (the launcher's own check for another g6m4 on this box sees the host's
# processes), the GPU, /dev/infiniband with IPC_LOCK and unlimited memlock, every other capability dropped, no new
# privileges, a read-only image with a private /tmp, GR8_USER's uid and gid, and at TP=6 GR8_USER's ~/.ssh (read-only:
# the TP=6 head's shim writes to the other ranks over ssh, as on bare metal). The engine runs with oom_score_adj 1000:
# under memory pressure the kernel ends the engine before sshd or the rest of the box.
set -eu
IMAGE=${GR8_IMAGE:-gr8}
NAME=gr8
me=$(id -un)
user=${GR8_USER:-$me}
if [ "$user" = "$me" ]; then uhome=$HOME; else uhome=$(getent passwd "$user" | cut -d: -f6) || true; fi
[ -n "$uhome" ] || { echo "docker/gr8: no account $user" >&2; exit 2; }
export G6_HOME=${G6_HOME:-$uhome/gr8-docker}

die() { echo "docker/gr8: $*" >&2; exit 2; }
usage() { sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//;p;}' "$0"; }

[ $# -gt 0 ] || { usage; exit 0; }
cmd=$1; shift
case $cmd in
  -h|--help|help) usage; exit 0 ;;
  up|down|restart|status|logs|check|show-config|prepare|smoke|bench) ;;
  build|stage|packs) die "$cmd: the image is the build; rebuild it with docker build -t $IMAGE ." ;;
  *) die "unknown command $cmd (docker/gr8 help)" ;;
esac
docker image inspect "$IMAGE" > /dev/null 2>&1 || die "no image $IMAGE: docker build -t $IMAGE . (or GR8_IMAGE=...)"

uid=$(id -u "$user"); gid=$(id -g "$user")
base=(--init --network host --pid host --user "$uid:$gid" -e HOME="$uhome"
      -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro -w "$PWD")

# the launcher's options that are set in this shell, and the variables below, reach the container as they would reach
# a bare-metal launcher
envs=()
keys=$(docker run --rm --entrypoint python3 "$IMAGE" -c \
    'import sys; sys.path.insert(0, "/opt/gr8/tools/launch"); import options; print(" ".join(options.KEYS))') ||
  die "could not read the launcher's option names from $IMAGE"
for k in $keys; do
  [ -n "${!k+x}" ] && envs+=(-e "$k")
done
for k in $(compgen -e); do
  # G6_* (engine and loader), GR8_* (the fetcher's GR8_HF_ENDPOINT, GR8_FETCH_WORKERS, ...) and HF_TOKEN; -e NAME passes
  # the value without putting it on a command line
  case $k in G6_*|GR8_*|HF_TOKEN) envs+=(-e "$k") ;; esac
done
# the shim runs on the image's python3 (stdlib only), not a venv in G6_HOME; an explicit PY still wins
[ -n "${PY+x}" ] || envs+=(-e PY=/usr/bin/python3)

# the paths the launcher will read and write, from its own option parsing. smoke and bench take a URL and the bench's
# own flags, not launcher options: only the config file and the environment name their paths
popts=("$@")
case $cmd in smoke|bench) popts=() ;; esac
# Nothing below reads GR8_USER's files from the host (you may not be able to): the checks run in the container, as
# GR8_USER, and --mount refuses a missing path where -v would create it, owned by root.
home='' tp=''
declare -A mode=([$PWD]=ro)
order=("$PWD")
add() {   # one mount per path; read-write wins
  [ -n "${mode[$2]+x}" ] || order+=("$2")
  [ "${mode[$2]:-}" = rw ] || mode[$2]=$1
}
# all of the helper's output or none of it: a helper that fails part way starts nothing
paths=$(docker run --rm "${base[@]}" --mount "type=bind,src=$PWD,dst=$PWD,readonly" "${envs[@]}" --entrypoint python3 \
          "$IMAGE" /opt/gr8/docker/mounts.py ${popts[@]+"${popts[@]}"}) || die "the options do not work here (above)"
while read -r kind path; do
  case $kind in
    home) home=$path ;;
    tp) tp=$path ;;
    # G6_HOME and the model cache: up and prepare create them, as the launcher does on bare metal. Another account's
    # paths may not be visible to you: they are mounted as given, and docker refuses a missing one.
    rw) if [ -d "$path" ] || [ "$user" != "$me" ]; then add rw "$path"
        elif [ "$cmd" = up ] || [ "$cmd" = restart ] || [ "$cmd" = prepare ]; then mkdir -p "$path"; add rw "$path"
        elif [ "$path" = "$home" ]; then die "no $home: nothing has run on this box (docker/gr8 up creates it)"
        fi ;;   # a missing model cache, for a command that does not fill it: the launcher's check names it
    # your own missing input is left out, so the launcher's check names it; another account's is mounted as given
    ro) [ "$user" = "$me" ] && [ ! -e "$path" ] || add ro "$path" ;;
  esac
done <<< "$paths"
[ -n "$home" ] && [ -n "$tp" ] || die "the options helper printed no G6_HOME or TP"
case $tp in 4) bin=bin ;; 6) bin=bin6 ;; 3) bin=bin3 ;; *) die "TP=$tp: want 4, 6 or 3" ;; esac
# TP=6 only: its head's shim reaches the other boxes over ssh with these keys (TP=4 and TP=3 pass requests over the
# engine's control links, so their containers get no keys). A box without ~/.ssh can still run a rank and the read-only
# commands. A named GR8_SSH must exist (docker says so), and so must another account's ~/.ssh if you cannot see it.
mounts=()
if [ "$tp" = 6 ] && { [ -n "${GR8_SSH:-}" ] || [ "$user" != "$me" ] || [ -d "$uhome/.ssh" ]; }; then
  mounts+=(--mount "type=bind,src=${GR8_SSH:-$uhome/.ssh},dst=$uhome/.ssh,readonly")
fi
for p in "${order[@]}"; do
  if [ "${mode[$p]}" = rw ]; then mounts+=(--mount "type=bind,src=$p,dst=$p")
  else mounts+=(--mount "type=bind,src=$p,dst=$p,readonly"); fi
done

run=("${base[@]}" "${envs[@]}" "${mounts[@]}" -e G6H="$home" --gpus all --device /dev/infiniband --ulimit memlock=-1
     --cap-drop ALL --cap-add IPC_LOCK --security-opt no-new-privileges --read-only
     --tmpfs "/tmp:rw,nosuid,nodev,size=1g,mode=1700,uid=$uid,gid=$gid")
# in the container, as GR8_USER: bin/ is the image's engine for this TP
prep="if [ -e \"\$G6H/bin\" ] && [ ! -L \"\$G6H/bin\" ]; then
        echo \"docker/gr8: \$G6H/bin is a directory (a bare-metal build?): pick another G6_HOME\" >&2; exit 2; fi
      ln -sfn /opt/gr8/$bin \"\$G6H/bin\" && mkdir -p \"\$G6H/out\""

running() { [ -n "$(docker ps -q --filter "name=^$NAME\$")" ]; }

# Whether this container's supervisor is serving: gr8.state names the supervisor's pid, as bare-metal up checks it.
# The container's shell writes its own pid to out/docker-up.pid and then becomes the supervisor (exec all the way down).
# The pid must also be alive: a killed boot leaves both files behind, naming the same dead pid (--pid host: host pids).
serving_check='import json, os
o = os.environ["G6H"] + "/out/"
with open(o + "gr8.state") as f:
    st = json.load(f)
with open(o + "docker-up.pid") as f:
    mine = int(f.read())
try:
    os.kill(mine, 0)
except ProcessLookupError:
    mine = None
print("serving" if mine and st.get("state") == "serving" and st.get("pid") == mine else "not yet")'

up() {
  running && die "container $NAME already runs on this box: docker/gr8 down first"
  local follow s
  # the supervisor's output goes to out/supervisor.log, as a bare-metal up writes it, and to docker logs
  docker run -d --rm --name "$NAME" --oom-score-adj 1000 "${run[@]}" --entrypoint bash "$IMAGE" -c "$prep
    echo \$\$ > \"\$G6H/out/docker-up.pid\"
    exec > >(tee -a \"\$G6H/out/supervisor.log\") 2>&1
    exec /opt/gr8/gr8 glm53 up --foreground \"\$@\"" bash "$@" > /dev/null
  echo "container $NAME, log $home/out/supervisor.log"
  docker logs -f "$NAME" 2>&1 &
  follow=$!
  trap 'kill $follow 2>/dev/null; echo; echo "the boot goes on in the container: docker/gr8 status, docker/gr8 logs supervisor, docker/gr8 down"; exit 130' INT
  while :; do
    sleep 1
    if ! running; then
      wait "$follow" 2>/dev/null || true
      echo "docker/gr8: the container stopped (the reason is above, and in $home/out)" >&2
      return 1
    fi
    s=$(docker exec "$NAME" python3 -c "$serving_check" 2>/dev/null) || true
    if [ "$s" = serving ]; then
      sleep 1; kill "$follow" 2>/dev/null || true
      return 0
    fi
  done
}

once() {
  local tty=() extra=()
  [ -t 0 ] && [ -t 1 ] && tty=(-it)
  if [ "$cmd" = bench ]; then
    # bench/pbench.py appends to results.jsonl next to itself, in the read-only image: keep it in G6_HOME/out instead
    docker run --rm "${run[@]}" --entrypoint bash "$IMAGE" -c \
      'mkdir -p "$G6H/out" && touch "$G6H/out/pbench-results.jsonl"'
    extra=(--mount "type=bind,src=$home/out/pbench-results.jsonl,dst=/opt/gr8/bench/results.jsonl")
  fi
  docker run --rm "${tty[@]}" "${run[@]}" "${extra[@]}" --entrypoint bash "$IMAGE" -c "$prep
    exec /opt/gr8/gr8 glm53 \"\$@\"" bash "$@"
}

case $cmd in
  up) up "$@" ;;
  # down asks every box's supervisor to stop and stops this one; its container leaves a moment after the supervisor
  restart) once down "$@" || die "down failed (above): not starting"
           for _ in $(seq 60); do running || break; sleep 1; done
           running && die "container $NAME has not stopped after down: docker/gr8 up once docker ps no longer lists it"
           up "$@" ;;
  *) once "$cmd" "$@" ;;
esac
